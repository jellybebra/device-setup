# Filled by dnsmasq from A answers for googlevideo.com. The connection label
# survives expiration of a DNS entry and keeps the negotiated TCP scale valid.
set youtube_video_v4 {
    type ipv4_addr
    flags timeout
    timeout 30m
    size 8192
}

chain youtube_video_quic {
    ip daddr @youtube_video_v4 udp dport 443 counter reject with icmp type port-unreachable
}

chain youtube_video_forward {
    type filter hook forward priority filter - 2; policy accept;
    iifname "br-lan" jump youtube_video_quic
}

chain youtube_video_input {
    type filter hook input priority filter - 2; policy accept;
    iifname "br-lan" jump youtube_video_quic
}

chain youtube_window_out {
    type filter hook postrouting priority srcnat - 3; policy accept;
    meta mark & 0x40000000 != 0 return
    ct direction original tcp dport 443 ip daddr @youtube_video_v4 tcp flags & (syn | ack) == syn ct label set ct label | 100
    ct direction original tcp dport 443 ct label 100 counter queue flags bypass to 325
}

chain youtube_window_in {
    type filter hook prerouting priority dstnat + 3; policy accept;
    ct direction reply tcp sport 443 ct label 100 tcp flags & (syn | rst | fin) != 0 counter queue flags bypass to 325
}
