#!/bin/sh /etc/rc.common
START=20
STOP=14
USE_PROCD=1

start_service() {
    local base=/opt/zapret2
    procd_open_instance
    procd_set_param command "$base/nfq2/nfqws2" --user=daemon --qnum=325 \
        --reasm-disable --ctrack-timeouts=60:8000:60:60 \
        "--lua-init=@$base/lua/zapret-lib.lua" "--lua-init=@$base/lua/youtube-window.lua" \
        --filter-tcp=443 --out-range=a --in-range=a --lua-desync=youtube_window
    procd_set_param respawn 3600 2 5
    procd_set_param stderr 1
    procd_close_instance
}
