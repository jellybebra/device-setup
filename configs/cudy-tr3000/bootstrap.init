#!/bin/sh /etc/rc.common
# Temporary loopback-only proxy for package downloads, never enabled at boot.
USE_PROCD=1
START=95
start_service() {
    procd_open_instance
    procd_set_param command /tmp/xray-26.10.29 run -config /tmp/bootstrap-xray.json
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
