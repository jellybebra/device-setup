#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    local enabled xray sha256 mark subscription_file
    config_load reality-finder
    config_get_bool enabled main enabled 0
    [ "$enabled" = 1 ] || return 0
    config_get xray main xray /opt/xray/xray
    config_get sha256 main sha256
    config_get mark main mark 255
    config_get subscription_file main subscription_file
    [ -x "$xray" ] && [ "${#sha256}" = 64 ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/python3 -u /opt/reality-finder/router.py \
        --data-dir /tmp/reality-finder serve --xray "$xray" --sha256 "$sha256" \
        --mark "$mark" --checkpoint /etc/reality-finder/reality.sqlite3
    [ -z "$subscription_file" ] || procd_append_param command --subscription-file "$subscription_file"
    procd_set_param env PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
    procd_set_param respawn 3600 10 5
    procd_set_param term_timeout 90
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="0 0"
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger reality-finder
}
