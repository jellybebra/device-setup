#!/bin/sh /etc/rc.common
START=96
STOP=9
USE_PROCD=1
start_service() {
    [ -f /etc/reality-finder/chain.json ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/python3 -u /opt/reality-finder/router_chain.py serve
    procd_set_param env PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
    procd_set_param respawn 3600 10 5
    procd_set_param term_timeout 45
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="0 0"
    procd_close_instance
}
