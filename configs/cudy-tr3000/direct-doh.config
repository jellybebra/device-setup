config main 'config'
    option dnsmasq_config_update '-'
    option force_dns '0'
    option notrack_dns '0'
    option canary_domains_icloud '0'
    option canary_domains_mozilla '0'
    option heartbeat_domain '-'
    option listen_addr '127.0.0.1'
    option user 'nobody'
    option group 'nogroup'
    option force_ip_family 'ipv4'

config https-dns-proxy 'cloudflare'
    option resolver_url 'https://1.1.1.1/dns-query'
    option bootstrap_dns '1.1.1.1'
    option listen_addr '127.0.0.1'
    option listen_port '15354'
