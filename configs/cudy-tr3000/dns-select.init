#!/bin/sh /etc/rc.common
START=21
STOP=14
USE_PROCD=1

start_resolver() {
    local name="$1"
    procd_open_instance "$name"
    procd_set_param command /usr/sbin/dnsmasq --keep-in-foreground \
        --conf-file="/etc/$name.conf" --pid-file="/var/run/$name.pid"
    procd_set_param file "/etc/$name.conf"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

start_service() {
    start_resolver dns-direct
    start_resolver dns-select
}
