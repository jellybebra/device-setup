<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="DeviceSetup">
  <Profiles>
    <SystemCollector Id="SC" Name="DeviceSetup scheduler">
      <BufferSize Value="1024" />
      <Buffers Value="64" />
    </SystemCollector>
    <SystemProvider Id="SP">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
        <Keyword Value="ThreadPriority" />
        <Keyword Value="CpuConfig" />
      </Keywords>
    </SystemProvider>
    <Profile Id="Scheduler.Verbose.File" Name="Scheduler" Description="Bounded scheduler timing only" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SC"><SystemProviderId Value="SP" /></SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
